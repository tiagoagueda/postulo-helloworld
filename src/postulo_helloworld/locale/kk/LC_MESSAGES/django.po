#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Жол жазылды. Сәлем, әлем!"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Жол емес, атау: файл осы дана плагинге беретін каталогта жасалады. Әр хабарландыру бір жол болып қосылады."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Файлға жазу мүмкін болмады: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Файл атауы"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Жолды емес, тек файл атауын беріңіз: %(name)s файл атауы емес."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Сәлемдесу"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Сәлем, әлем"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Әр жолдың басында тұрады, осылайша бұл плагиннің жолдарын ажырата аласыз."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Бұл — Postulo-дан келген сынақ."
