#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "A line was written. Hello, world!"
msgstr "Γράφτηκε μια γραμμή. Γεια σου, κόσμε!"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Ένα όνομα, όχι μια διαδρομή: το αρχείο δημιουργείται στον κατάλογο αυτή η περίπτωση δίνει το πρόσθετο. Κάθε κοινοποίηση επισυνάπτεται ως μία γραμμή."

#: src/postulo_helloworld/notifier.py
#, fuzzy, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Δεν ήταν δυνατή η εγγραφή στο αρχείο: %(error)s"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "File name"
msgstr "Όνομα αρχείου"

#: src/postulo_helloworld/notifier.py
#, fuzzy, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Δώστε το όνομα ενός αρχείου από μόνο του, δεν είναι μια διαδρομή: %(name)s δεν είναι ένα."

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "Greeting"
msgstr "Χαιρετισμός"

#: src/postulo_helloworld/notifier.py
#, fuzzy
