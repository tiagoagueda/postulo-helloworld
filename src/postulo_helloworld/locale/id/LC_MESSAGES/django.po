#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Sebuah baris ditulis. Halo, dunia!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Nama, bukan path: berkas dibuat di direktori yang diberikan instans ini kepada plugin. Setiap notifikasi ditambahkan sebagai satu baris."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Tidak dapat menulis ke berkas: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Nama berkas"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Berikan nama berkas saja, bukan path: %(name)s bukan nama berkas."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Salam"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Halo dunia"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Mengawali setiap baris, sehingga Anda dapat membedakan baris dari plugin ini."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Ini adalah pengujian dari Postulo."
