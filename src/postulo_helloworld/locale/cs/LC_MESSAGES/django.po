#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Byl zapsán řádek. Ahoj, světe!"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Název, ne cesta: soubor je vytvořen v adresáři tento instance dává plugin. Každé oznámení je přiloženo jako jeden řádek."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Do souboru se nepodařilo zapsat: %(error)s"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "File name"
msgstr "Název souboru"

#: src/postulo_helloworld/notifier.py
#, fuzzy, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Uveďte název souboru sám o sobě, ne cestu: %(name)s není jeden."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Pozdrav"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Ahoj světe"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Začíná každý řádek, abyste řádky tohoto pluginu rozeznali."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Toto je test z Postulo."
