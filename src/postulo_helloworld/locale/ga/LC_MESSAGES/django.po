#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Scríobhadh líne. Dia duit, a dhomhain!"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "A ainm, ní cosán: Tá an comhad a cruthaíodh san eolaire Tugann an cás seo an breiseán. Tá gach fógra i gceangal mar líne amháin."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Níorbh fhéidir scríobh chuig an gcomhad: %(error)s"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "File name"
msgstr "Ainm comhaid"

#: src/postulo_helloworld/notifier.py
#, fuzzy, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Tabhair an t-ainm comhaid ar a chuid féin, ní cosán: %(name)s nach bhfuil ceann."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Beannacht"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Dia duit a dhomhain"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Tosaíonn sé gach líne, ionas gur féidir leat línte an bhreiseáin seo a aithint thar a chéile."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Tástáil ó Postulo é seo."
