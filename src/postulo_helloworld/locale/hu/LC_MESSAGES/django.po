#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Egy sor ki lett írva. Helló, világ!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Név, nem elérési út: a fájl abban a könyvtárban jön létre, amelyet ez a példány a bővítménynek biztosít. Minden értesítés egy-egy új sorként kerül a fájl végére."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Nem sikerült a fájlba írni: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Fájlnév"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Csak egy fájlnevet adjon meg, ne elérési utat; ez nem fájlnév: %(name)s."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Üdvözlés"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Helló, világ"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Minden sor elején áll, így megkülönböztethetők a bővítmény sorai."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Ez egy teszt a Postulóból."
