#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Ysgrifennwyd llinell. Helo, fyd!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Enw, nid llwybr: caiff y ffeil ei chreu yn y cyfeiriadur y mae'r gosodiad hwn yn ei roi i'r ategyn. Ychwanegir pob hysbysiad fel un llinell."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Ni ellid ysgrifennu i'r ffeil: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Enw ffeil"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Rhowch enw ffeil ar ei ben ei hun, nid llwybr: nid yw %(name)s yn un."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Cyfarchiad"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Helo fyd"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Yn dechrau pob llinell, er mwyn i chi allu adnabod llinellau'r ategyn hwn."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Prawf gan Postulo yw hwn."
