#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Eine Zeile wurde geschrieben. Hallo, Welt!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Ein Name, kein Pfad: Die Datei wird im Verzeichnis erstellt, das diese Instanz dem Plugin gibt. Jede Benachrichtigung wird als eine Zeile angefügt."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Die Datei konnte nicht geschrieben werden: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Dateiname"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Geben Sie nur den Namen einer Datei an, keinen Pfad: %(name)s ist kein Dateiname."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Begrüßung"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Hallo Welt"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Steht am Anfang jeder Zeile, damit Sie die Zeilen dieses Plugins erkennen."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Dies ist ein Test von Postulo."
