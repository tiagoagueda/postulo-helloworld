#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Një rresht u shkrua. Përshëndetje, botë!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Një emër, jo një shteg: skedari krijohet në dosjen që kjo instancë i jep shtojcës. Çdo njoftim shtohet si një rresht."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Nuk mund të shkruhej në skedar: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Emri i skedarit"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Jepni vetëm emrin e një skedari, jo një shteg: %(name)s nuk është i tillë."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Përshëndetje"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Përshëndetje botë"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Fillon çdo rresht, që të mund t'i dalloni rreshtat e kësaj shtojce."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Ky është një test nga Postulo."
