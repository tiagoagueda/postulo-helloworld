#: src/postulo_helloworld/notifier.py:65
#, draft
msgid "A line was written. Hello, world!"
msgstr "Scríobhadh líne. Dia duit, a dhomhain!"

#: src/postulo_helloworld/notifier.py:63
#, python-format, draft
msgid "Could not write to the file: %(error)s"
msgstr "Níorbh fhéidir scríobh chuig an gcomhad: %(error)s"

#: src/postulo_helloworld/notifier.py:45
#, draft
msgid "Each notification is appended as one line. The file is created."
msgstr "Cuirtear gach fógra leis mar líne amháin. Cruthaítear an comhad."

#: src/postulo_helloworld/notifier.py:43
#, draft
msgid "File to write to"
msgstr "Comhad le scríobh chuige"

#: src/postulo_helloworld/notifier.py:49
#, draft
msgid "Greeting"
msgstr "Beannacht"

#: src/postulo_helloworld/notifier.py:36
#, draft
msgid "Hello world"
msgstr "Dia duit a dhomhain"

#: src/postulo_helloworld/notifier.py:53
#, draft
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr ""
"Tosaíonn sé gach líne, ionas gur féidir leat línte an bhreiseáin seo a aithint thar a chéile."

#: src/postulo_helloworld/notifier.py:60
#, draft
