#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "ایک لائن لکھی گئی۔ ہیلو، دنیا!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "ایک نام، پاتھ نہیں: فائل اس ڈائریکٹری میں بنتی ہے جو یہ انسٹینس پلگ ان کو دیتا ہے۔ ہر اطلاع ایک سطر کے طور پر آخر میں شامل کی جاتی ہے۔"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "فائل میں نہیں لکھا جا سکا: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "فائل کا نام"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "صرف فائل کا نام دیں، پاتھ نہیں: %(name)s فائل کا نام نہیں ہے۔"

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "سلام"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "ہیلو دنیا"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "ہر سطر کے شروع میں آتا ہے، تاکہ آپ اس پلگ ان کی سطریں الگ پہچان سکیں۔"

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "یہ Postulo کی طرف سے ایک آزمائش ہے۔"
