#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "A fost scrisă o linie. Salut, lume!"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Un nume, nu o cale: fișierul este creat în directorul acest exemplu oferă plugin-ul. Fiecare notificare este anexată ca o singură linie."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Nu s-a putut scrie în fișier: %(error)s"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "File name"
msgstr "Denumire fișier"

#: src/postulo_helloworld/notifier.py
#, fuzzy, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Dați numele unui fișier pe cont propriu, nu o cale: %(name)s nu este una."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Formulă de salut"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Salut lume"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Începe fiecare linie, ca să poți deosebi liniile acestui plugin."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Acesta este un test de la Postulo."
