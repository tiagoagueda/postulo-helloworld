#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Sətir yazıldı. Salam, dünya!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Yol deyil, ad: fayl bu instansiyanın plaginə ayırdığı qovluqda yaradılır. Hər bildiriş bir sətir kimi əlavə edilir."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Fayla yazmaq mümkün olmadı: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Fayl adı"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Yol deyil, yalnız faylın adını verin: %(name)s fayl adı deyil."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Salamlama"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Salam dünya"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Hər sətrin əvvəlində gəlir ki, bu plaginin sətirlərini ayırd edə biləsiniz."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Bu, Postulo-dan test mesajıdır."
