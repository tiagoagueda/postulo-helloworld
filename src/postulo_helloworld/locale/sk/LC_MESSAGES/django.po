#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Riadok bol zapísaný. Ahoj, svet!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Názov, nie cesta: súbor sa vytvorí v adresári, ktorý táto inštancia pridelí zásuvnému modulu. Každé oznámenie sa pripíše ako jeden riadok."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Do súboru sa nepodarilo zapísať: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Názov súboru"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Zadajte iba názov súboru, nie cestu: %(name)s nie je názov súboru."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Pozdrav"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Ahoj svet"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Začína každý riadok, aby ste riadky tohto doplnku rozoznali."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Toto je test z aplikácie Postulo."
