#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "En rad skrevs. Hej, världen!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Ett namn, inte en sökväg: filen skapas i den katalog som den här instansen ger tillägget. Varje notis läggs till som en rad."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Kunde inte skriva till filen: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Filnamn"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Ange bara namnet på en fil, inte en sökväg: %(name)s är inte det."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Hälsning"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Hej världen"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Inleder varje rad, så att du kan skilja det här tilläggets rader från andra."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Det här är ett test från Postulo."
