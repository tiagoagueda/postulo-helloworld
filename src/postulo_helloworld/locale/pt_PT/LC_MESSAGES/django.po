#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Foi escrita uma linha. Olá, mundo!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Um nome, não um caminho: o ficheiro é criado na pasta que esta instância dá ao plugin. Cada notificação é acrescentada numa linha."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Não foi possível escrever no ficheiro: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Nome do ficheiro"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Indique apenas o nome de um ficheiro, não um caminho: %(name)s não é um nome."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Saudação"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Olá, mundo"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Começa cada linha, para distinguir as deste plugin."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Isto é um teste enviado pelo Postulo."
