#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Se escribió una línea. ¡Hola, mundo!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Un nombre, no una ruta: el archivo se crea en el directorio que esta instancia le asigna al complemento. Cada notificación se agrega como una línea."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "No se pudo escribir en el archivo: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Nombre del archivo"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Indica solo el nombre de un archivo, no una ruta: %(name)s no lo es."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Saludo"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Hola mundo"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Va al inicio de cada línea, para que puedas distinguir las líneas de este complemento."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Esta es una prueba de Postulo."
