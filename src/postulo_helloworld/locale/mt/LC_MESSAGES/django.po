#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Inkitbet linja. Hello, world!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Isem, mhux path: il-fajl jinħoloq fid-direttorju li din l-istanza tagħti lill-plugin. Kull notifika tiżdied fit-tarf bħala linja waħda."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Ma setax jinkiteb fil-fajl: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Isem il-fajl"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Agħti l-isem ta' fajl waħdu, mhux path: %(name)s mhuwiex isem ta' fajl."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Tislima"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Hello world"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Tibda kull linja, biex tkun tista' tagħraf il-linji ta' dan il-plugin."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Dan huwa test minn Postulo."
