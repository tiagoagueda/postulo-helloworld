#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Escribiuse unha liña. Ola, mundo!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Un nome, non unha ruta: o ficheiro créase no directorio que esta instancia lle dá ao complemento. Cada notificación engádese como unha liña."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Non se puido escribir no ficheiro: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Nome do ficheiro"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Indica só o nome dun ficheiro, non unha ruta: %(name)s non o é."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Saúdo"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Ola, mundo"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Vai ao comezo de cada liña, para que poidas distinguir as liñas deste complemento."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Esta é unha proba do Postulo."
