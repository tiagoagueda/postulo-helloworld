#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "A line was written. Hello, world!"
msgstr "Barua ilikuwa imeandikwa. Hello, ulimwengu wote!"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Jina, sio njia: faili imeundwa katika saraka hii inatoa Plugin. Kila ishara inaonyeshwa kama mstari mmoja."

#: src/postulo_helloworld/notifier.py
#, fuzzy, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Haiwezi kuandika kwenye faili: %(error)s"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "File name"
msgstr "Jina la faili"

#: src/postulo_helloworld/notifier.py
#, fuzzy, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Weka jina la faili pekee, si njia: %(name)s si jina la faili."

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "Greeting"
msgstr "Salamu kwa Mhe"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "Hello world"
msgstr "Hello ulimwengu wa"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Kuanza kila mstari, hivyo unaweza kusema mistari hii ya Plugin mbali."

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "This is a test from Postulo."
msgstr "Hii ni kwa mujibu wa Postulo."
