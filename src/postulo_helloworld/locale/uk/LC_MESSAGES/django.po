#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Рядок записано. Привіт, світе!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Назва, а не шлях: файл створюється в каталозі, який цей екземпляр надає плагіну. Кожне сповіщення дописується одним рядком."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Не вдалося записати у файл: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Назва файлу"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Вкажіть лише назву файлу, а не шлях: %(name)s — не назва файлу."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Вітання"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Привіт, світе"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Стоїть на початку кожного рядка, щоб ви могли відрізнити рядки цього плагіна."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Це тест від Postulo."
