#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Ina lingia è vegnida scritta. Allegra, mund!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "In num, betg ina via: la datoteca vegn creada en l'ordinatur che questa instanza dat al plugin. Mintga communicaziun vegn agiuntada sco ina lingia."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Impussibel da scriver en la datoteca: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Num da la datoteca"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Indicai mo il num d'ina datoteca, betg ina via: %(name)s n'è betg in."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Salid"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Allegra, mund"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Cumenza mintga lingia, uschia che Vus pudais distinguer las lingias da quest plugin."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Quai è in test da Postulo."
