#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "একটি লাইন লেখা হয়েছে। Hello, world!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "একটি নাম, পাথ নয়: ফাইলটি সেই ডিরেক্টরিতে তৈরি হয় যা এই ইনস্ট্যান্স প্লাগইনটিকে দেয়। প্রতিটি বিজ্ঞপ্তি একটি লাইন হিসেবে শেষে যোগ করা হয়।"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "ফাইলে লেখা যায়নি: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "ফাইলের নাম"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "পাথ নয়, শুধু একটি ফাইলের নাম দিন: %(name)s তা নয়।"

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "শুভেচ্ছাবাক্য"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Hello world"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "প্রতিটি লাইনের শুরুতে থাকে, যাতে আপনি এই প্লাগইনের লাইনগুলো আলাদা করে চিনতে পারেন।"

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "এটি Postulo থেকে একটি পরীক্ষা।"
