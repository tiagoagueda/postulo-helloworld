#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Red je napisan. Zdravo, svijete!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Naziv, ne putanja: datoteka se kreira u folderu koji ova instanca daje dodatku. Svako obavještenje dodaje se kao jedan red."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Nije moguće pisati u datoteku: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Naziv datoteke"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Navedite samo naziv datoteke, ne putanju: %(name)s to nije."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Pozdrav"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Zdravo, svijete"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Stoji na početku svakog reda, da biste redove ovog dodatka mogli razlikovati od ostalih."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Ovo je test iz Postula."
