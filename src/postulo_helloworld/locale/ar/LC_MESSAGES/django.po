#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "تمت كتابة سطر. مرحبًا يا عالم!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "اسم، لا مسار: يُنشأ الملف في المجلد الذي يخصّصه هذا المثيل للمكوّن الإضافي. يُلحق كل إشعار سطرًا واحدًا."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "تعذّرت الكتابة إلى الملف: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "اسم الملف"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "اكتب اسم ملف وحده، لا مسارًا: %(name)s ليس اسم ملف."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "التحية"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Hello world"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "يبدأ بها كل سطر، لتميّز أسطر هذا المكوّن الإضافي عن غيرها."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "هذا اختبار من Postulo."
