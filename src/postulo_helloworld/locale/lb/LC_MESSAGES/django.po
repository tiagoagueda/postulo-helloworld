#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Eng Zeil gouf geschriwwen. Moien, Welt!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "En Numm, kee Pad: de Fichier gëtt am Dossier ugeluecht, deen dës Instanz dem Plugin gëtt. All Benoriichtegung gëtt als eng Zeil drugehaang."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Konnt net an de Fichier schreiwen: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Fichiersnumm"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Gitt just den Numm vun engem Fichier un, kee Pad: %(name)s ass keen."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Begréissung"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Moien Welt"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Steet um Ufank vun all Zeil, sou datt Dir d'Zeile vun dësem Plugin erkenne kënnt."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Dat hei ass en Test vum Postulo."
