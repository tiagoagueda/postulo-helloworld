#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Eilutė įrašyta. Labas, pasauli!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Pavadinimas, ne kelias: failas sukuriamas kataloge, kurį šis egzempliorius skiria papildiniui. Kiekvienas pranešimas pridedamas kaip viena eilutė."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Nepavyko įrašyti į failą: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Failo pavadinimas"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Nurodykite tik failo pavadinimą, o ne kelią: %(name)s toks nėra."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Pasisveikinimas"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Labas, pasauli"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Pradeda kiekvieną eilutę, kad atskirtumėte šio papildinio eilutes."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Tai bandymas iš Postulo."
