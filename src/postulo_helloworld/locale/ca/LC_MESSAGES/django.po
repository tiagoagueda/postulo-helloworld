#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "S'ha escrit una línia. Hola, món!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Un nom, no un camí: el fitxer es crea al directori que aquesta instància assigna al connector. Cada notificació s'hi afegeix com una línia."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "No s'ha pogut escriure al fitxer: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Nom del fitxer"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Indiqueu només el nom d'un fitxer, no un camí: %(name)s no ho és."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Salutació"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Hola món"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Encapçala cada línia, perquè pugueu distingir les línies d'aquest connector."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Aquesta és una prova de Postulo."
