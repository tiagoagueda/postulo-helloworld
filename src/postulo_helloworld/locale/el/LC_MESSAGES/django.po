msgstr "Γεια σου κόσμε"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Ξεκινά κάθε γραμμή, ώστε να ξεχωρίζετε τις γραμμές αυτού του πρόσθετου."

