#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Rivi kirjoitettiin. Hei, maailma!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Nimi, ei polku: tiedosto luodaan hakemistoon, jonka tämä instanssi antaa liitännäiselle. Kukin ilmoitus lisätään tiedostoon yhtenä rivinä."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Tiedostoon ei voitu kirjoittaa: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Tiedoston nimi"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Anna pelkkä tiedoston nimi, ei polkua: %(name)s ei ole sellainen."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Tervehdys"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Hei maailma"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Aloittaa jokaisen rivin, jotta erotat tämän liitännäisen rivit muista."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Tämä on testi Postulosta."
