#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Запишан е ред. Hello, world!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Име, не патека: датотеката се создава во папката што оваа инстанца му ја дава на додатокот. Секое известување се додава како еден ред."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Не може да се запише во датотеката: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Име на датотеката"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Внесете само име на датотека, не патека: %(name)s не е такво."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Поздрав"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Hello world"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Го започнува секој ред, за да ги разликувате редовите на овој додаток."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Ова е проба од Postulo."
