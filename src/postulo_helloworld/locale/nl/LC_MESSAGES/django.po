#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Er is een regel geschreven. Hallo, wereld!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Een naam, geen pad: het bestand wordt aangemaakt in de map die deze instantie de plugin geeft. Elke melding wordt als één regel toegevoegd."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Kon niet naar het bestand schrijven: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Bestandsnaam"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Geef alleen de naam van een bestand, geen pad: %(name)s is dat niet."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Begroeting"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Hallo wereld"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Begint elke regel, zodat u de regels van deze plugin kunt herkennen."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Dit is een test van Postulo."
