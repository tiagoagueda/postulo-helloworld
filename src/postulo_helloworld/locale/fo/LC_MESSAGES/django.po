#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "A line was written. Hello, world!"
msgstr "Ein linja varð skrivað. Hey, verð!"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Eitt navn, ikki ein leið: fílan verður stovnað í mappuni, sum henda uppsetingin gevur viðbótini. Hvør fráboðan verður løgd aftrat sum ein linja."

#: src/postulo_helloworld/notifier.py
#, fuzzy, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Kundi ikki skriva til fíluna: %(error)s"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "File name"
msgstr "Fílunavn"

#: src/postulo_helloworld/notifier.py
#, fuzzy, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Gev navnið á eini fílu einsamalt, ikki eina leið: %(name)s er ikki tað."

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "Greeting"
msgstr "Heilsan"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "Hello world"
msgstr "Hello world"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Byrjar hvørja linju, so tú kanst skilja linjurnar hjá hesi viðbótini frá."

#: src/postulo_helloworld/notifier.py
#, fuzzy
