#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "A line was written. Hello, world!"
msgstr "Ei linje vart skriven. Hei, verda!"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Eit namn, ikkje ein sti: fila blir oppretta i katalogen denne instansen gir tillegget. Kvar varsling blir lagd til som éi linje."

#: src/postulo_helloworld/notifier.py
#, fuzzy, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Kunne ikkje skrive til fila: %(error)s"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "File name"
msgstr "Filnamn"

#: src/postulo_helloworld/notifier.py
#, fuzzy, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Oppgi berre namnet på ei fil, ikkje ein sti: %(name)s er ikkje det."

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "Greeting"
msgstr "Helsing"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "Hello world"
msgstr "Hello world"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Står først på kvar linje, så du kan skilje linjene til dette tillegget frå andre."

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "This is a test from Postulo."
msgstr "Dette er ein test frå Postulo."
