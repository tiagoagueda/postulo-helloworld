#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Bir satır yazıldı. Merhaba, dünya!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Bir ad, yol değil: dosya bu kurulumun eklentiye ayırdığı dizinde oluşturulur. Her bildirim tek satır olarak eklenir."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Dosyaya yazılamadı: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Dosya adı"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Yol değil, yalnızca bir dosya adı verin: %(name)s bir dosya adı değil."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Selamlama"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Merhaba dünya"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Her satırın başına gelir, böylece bu eklentinin satırlarını ayırt edebilirsiniz."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Bu, Postulo'dan bir test."
