#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Lerro bat idatzi da. Kaixo, mundua!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Izen bat, ez bide bat: fitxategia instantzia honek pluginari ematen dion direktorioan sortzen da. Jakinarazpen bakoitza lerro gisa eransten da."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Ezin izan da fitxategian idatzi: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Fitxategi-izena"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Eman fitxategi baten izena soilik, ez bide bat: %(name)s ez da horrelakoa."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Agurra"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Kaixo mundua"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Lerro bakoitzaren hasieran doa, plugin honen lerroak bereizi ahal izateko."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Postuloren proba da hau."
