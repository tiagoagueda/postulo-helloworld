#: src/postulo_helloworld/notifier.py:155
msgid "A line was written. Hello, world!"
msgstr "Une ligne a été écrite. Bonjour le monde !"

#: src/postulo_helloworld/notifier.py:121
msgid ""
"A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr ""
"Un nom, pas un chemin : le fichier est créé dans le répertoire que cette instance donne au plugin. Chaque notification est ajoutée sur une ligne."

#: src/postulo_helloworld/notifier.py:153
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Impossible d'écrire dans le fichier : %(error)s"

#: src/postulo_helloworld/notifier.py:118
msgid "File name"
msgstr "Nom du fichier"

#: src/postulo_helloworld/notifier.py:91 src/postulo_helloworld/notifier.py:98
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr ""
"Indiquez un nom de fichier seul, pas un chemin : %(name)s n’en est pas un."

#: src/postulo_helloworld/notifier.py:129
msgid "Greeting"
msgstr "Salutation"

#: src/postulo_helloworld/notifier.py:111
msgid "Hello world"
msgstr "Bonjour le monde"

#: src/postulo_helloworld/notifier.py:133
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Commence chaque ligne, pour reconnaître celles de ce plugin."

#: src/postulo_helloworld/notifier.py:148
msgid "This is a test from Postulo."
msgstr "Ceci est un test envoyé par Postulo."
