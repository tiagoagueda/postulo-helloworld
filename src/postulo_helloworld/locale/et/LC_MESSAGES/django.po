#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Rida kirjutati. Tere, maailm!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Nimi, mitte tee: fail luuakse kataloogi, mille see Postulo pluginale annab. Iga teavitus lisatakse ühe reana."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Faili ei õnnestunud kirjutada: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Failinimi"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Sisestage ainult faili nimi, mitte tee: %(name)s ei ole failinimi."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Tervitus"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Tere maailm"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Alustab iga rida, et saaksite selle plugina read teistest eristada."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "See on Postulo test."
