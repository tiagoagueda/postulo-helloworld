#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Rinda ierakstīta. Sveika, pasaule!"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Nosaukums, nevis ceļš: fails ir izveidots direktorijā šī instance dod spraudnis. Katrs paziņojums ir pievienots kā viena rinda."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Neizdevās ierakstīt failā: %(error)s"

#: src/postulo_helloworld/notifier.py
#, fuzzy
msgid "File name"
msgstr "Faila nosaukums"

#: src/postulo_helloworld/notifier.py
#, fuzzy, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Norādiet faila nosaukumu, nevis ceļu: %(name)s nav viens."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Sveiciens"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Sveika, pasaule"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Sāk katru rindu, lai varētu atšķirt šī spraudņa rindas."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Šis ir tests no Postulo."
