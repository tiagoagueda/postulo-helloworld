#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "È stata scritta una riga. Ciao, mondo!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Un nome, non un percorso: il file viene creato nella directory che questa istanza assegna al plugin. Ogni notifica viene aggiunta come una riga."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Impossibile scrivere nel file: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Nome del file"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Indica solo il nome di un file, non un percorso: %(name)s non lo è."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Saluto"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Ciao mondo"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Apre ogni riga, così puoi distinguere le righe di questo plugin."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Questo è un test di Postulo."
