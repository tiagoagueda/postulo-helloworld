#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Գրվեց մեկ տող։ Բարև, աշխարհ։"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Անուն, ոչ թե ուղի․ ֆայլը ստեղծվում է այն թղթապանակում, որը այս տեղակայումը տրամադրում է հավելմանը։ Յուրաքանչյուր ծանուցում ավելացվում է որպես մեկ տող։"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Չհաջողվեց գրել ֆայլում՝ %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Ֆայլի անուն"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Նշեք միայն ֆայլի անունը, ոչ թե ուղին․ %(name)s արժեքն այդպիսին չէ։"

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Ողջույն"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Բարև, աշխարհ"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Սկսում է յուրաքանչյուր տող, որպեսզի կարողանաք տարբերել այս հավելման տողերը։"

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Սա փորձնական հաղորդագրություն է Postulo-ից։"
