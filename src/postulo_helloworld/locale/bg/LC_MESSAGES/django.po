#: src/postulo_helloworld/notifier.py
msgid "A line was written. Hello, world!"
msgstr "Записан е ред. Здравей, свят!"

#: src/postulo_helloworld/notifier.py
msgid "A name, not a path: the file is created in the directory this instance gives the plugin. Each notification is appended as one line."
msgstr "Име, а не път: файлът се създава в директорията, която тази инстанция дава на добавката. Всяко известие се добавя като един ред."

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Could not write to the file: %(error)s"
msgstr "Файлът не можа да бъде записан: %(error)s"

#: src/postulo_helloworld/notifier.py
msgid "File name"
msgstr "Име на файл"

#: src/postulo_helloworld/notifier.py
#, python-format
msgid "Give the name of a file on its own, not a path: %(name)s is not one."
msgstr "Дайте само името на файл, а не път: %(name)s не е такъв."

#: src/postulo_helloworld/notifier.py
msgid "Greeting"
msgstr "Поздрав"

#: src/postulo_helloworld/notifier.py
msgid "Hello world"
msgstr "Здравей, свят"

#: src/postulo_helloworld/notifier.py
msgid "Starts every line, so you can tell this plugin's lines apart."
msgstr "Започва всеки ред, за да различавате редовете на тази добавка."

#: src/postulo_helloworld/notifier.py
msgid "This is a test from Postulo."
msgstr "Това е тест от Postulo."
